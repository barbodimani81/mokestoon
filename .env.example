# make init creates .env with a random local database password.
PGHOST=127.0.0.1
PGPORT=55432
PGUSER=f7
PGDATABASE=f7
PGPASSWORD=
PGSSLMODE=disable
HTTP_ADDR=127.0.0.1:8080
# Set F7_PLAYTEST=1 in your private .env to enable local-only development pricing.
APP_ENV=local
F7_PLAYTEST=0
PUBLIC_WEB_ORIGIN=http://127.0.0.1:5173
# make accounts-api enables the optional local email provider and test economy.
F7_MAIL_SMTP_PORT=51025
F7_MAIL_UI_PORT=58025
